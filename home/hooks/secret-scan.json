{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(search_replace|write_file|create_file|edit_file|apply_patch|bash|run_terminal_cmd|Write|Edit|MultiEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "__OMA_SECRET_SCAN_CMD__",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
